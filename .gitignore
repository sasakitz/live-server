/target

# Claude Codeのローカル設定(許可リストなど、個人の作業環境に紐づくため追跡しない)
/.claude/

# ローカル開発時に生成される実行時データ(秘密情報を含むため追跡しない)
/config.toml
/data/
*.db
*.db-shm
*.db-wal
session_key.bin

# 個人環境・エージェント・クラウド認証の設定
/.agents/
/.codex/
/.aws/
/.vscode/
/.idea/

# 環境別の実設定と認証情報(サンプルだけは公開する)
/config.*.toml
!/config.example.toml
/deploy/config.toml
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# 個人用メモ・履歴バックアップ・ログはローカル専用
/.local/
*.log
