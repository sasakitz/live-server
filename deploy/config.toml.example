# live-server 本番用設定例。
# /etc/live-server/config.toml として配置する(install.sh参照)。
# 値は必ず環境に合わせて書き換えてください。

[server]
bind = "127.0.0.1:8080"
public_host = "live.example.com"
data_dir = "/var/lib/live-server"
secure_cookies = true

[webrtc]
# このサーバの「公開」IPアドレス。OBS/ブラウザのICE候補として広告される。
# クラウドVMの場合は割り当てられたグローバルIP、自宅サーバ等の場合は
# ルータのグローバルIP(+ポート開放/DMZ設定)を指定する。
# IPv4/IPv6のデュアルスタックであれば両方列挙できる:
#   public_ips = ["203.0.113.10", "2001:db8::1"]
public_ips = ["203.0.113.10", "2001:db8::10"]
# public_ipsに加えて収集するローカルNICアドレス(任意)。
# IPv4 NAT配下ではサーバ機自身のLAN側IPv4を指定する。
# public_ipsのNIC直結IPv6は、bind_ipsに書かなくても収集される。
# 例: public_ips = ["203.0.113.10", "2001:db8::10"] のIPv4 NAT + IPv6環境では:
#   bind_ips = ["192.168.1.7"]
# アドレス確認: ip -4 addr show / ip -6 addr show scope global
# UDPポート範囲をIPv4/IPv6の両方で許可し、必要なICMPv6も通すこと。
udp_port_min = 5000
udp_port_max = 5200
stun_servers = ["stun:stun.l.google.com:19302"]

[auth]
public_viewing = false

[[auth.admin_bootstrap]]
username = "admin"
password = "change-me-please"

[discord]
# default_webhook_url = "https://discord.com/api/webhooks/xxxx/yyyy"

[db]
url = "sqlite:///var/lib/live-server/live.db"
